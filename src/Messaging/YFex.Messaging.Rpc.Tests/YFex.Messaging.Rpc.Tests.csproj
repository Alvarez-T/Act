<Project Sdk="Microsoft.NET.Sdk">

  <!-- Real client ↔ server Fusion RPC round-trips in one process (ActualLab RpcTestClient). Imports the package
       .targets like a NuGet consumer, so the CQRS generator emits the RPC contracts (YFEX_RPC). -->
  <Import Project="..\YFex.Messaging.Rpc\build\YFex.Messaging.Rpc.targets" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>YFex.Messaging.Rpc.Tests</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <NoWarn>$(NoWarn);CS1591;xUnit1031;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- Test-only (approved): NOT used as an analyzer here — the CQRS generator emits the contract proxies itself (D30).
         ProxyGoldenTests loads it from the package folder and runs it on a source copy of the generated contract to prove
         our emitted proxies are byte-identical to ActualLab's. Pinned with ActualLab.Fusion (13.0.12). -->
    <PackageReference Include="ActualLab.Generators" Version="13.0.12" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <!-- Roslyn driver for the golden test (same pin as the repo's generator tests). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.5.26302.115" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Messaging.Rpc\YFex.Messaging.Rpc.csproj" />
    <ProjectReference Include="..\..\Cqrs\YFex.Cqrs\YFex.Cqrs.csproj" />
    <ProjectReference Include="..\..\State\YFex.State\YFex.State.csproj" />
    <!-- Analyzer for this project AND a plain reference: ProxyGoldenTests drives CQRSGenerator directly. -->
    <ProjectReference Include="..\..\Cqrs\YFex.Cqrs.SourceGenerator\YFex.Cqrs.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\YFex.Messaging.Rpc.Generator\YFex.Messaging.Rpc.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Validation\YFex.Validation.Generator\YFex.Validation.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\State\YFex.State.Generator\YFex.State.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ActualLabGenerators</_Parameter1>
      <_Parameter2>$(PkgActualLab_Generators)\analyzers\dotnet\cs\ActualLab.Generators.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
