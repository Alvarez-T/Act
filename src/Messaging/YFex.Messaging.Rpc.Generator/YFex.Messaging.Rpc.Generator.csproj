<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<ImplicitUsings>disable</ImplicitUsings>

		<PackageId>YFex.Messaging.Rpc.Generator</PackageId>
		<Version>1.0.0</Version>
		<Authors>YFex</Authors>
		<Description>Incremental source generator that emits a reflection-free outbox command replay map (OutboxCommandRegistry) for YFex.Messaging.Rpc, replacing Type.GetType + MakeGenericMethod dispatch for AOT/trim safety.</Description>
		<PackageTags>yfex;messaging;rpc;outbox;sourcegenerator;roslyn;aot</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
	</ItemGroup>
</Project>
