<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runtime-authored rules (validation 05 §8, Phase 6): JSON rule specs whose conditions and values are YFex.Expressions
       expressions (type-checked at publish, compiled once to postfix programs, run over ISituation<T>.Read through
       SituationReader). Plugs into YFex.Rules through IRuntimeRuleCodec (host.UseRuntimeRules).
       Layer 1.5: → YFex.Rules + YFex.Expressions (Phase X) (+ YFex.Persistence). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>YFex.Rules.Dynamic</RootNamespace>
    <AssemblyName>YFex.Rules.Dynamic</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Rules\YFex.Rules.csproj" />
    <ProjectReference Include="..\..\Expressions\YFex.Expressions\YFex.Expressions.csproj" />
    <ProjectReference Include="..\..\Persistence\YFex.Persistence\YFex.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="YFex.Expressions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YFex.Rules.Dynamic.Tests" />
  </ItemGroup>

</Project>
