<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>YFex.Rules</RootNamespace>
    <AssemblyName>YFex.Rules</AssemblyName>
  </PropertyGroup>

  <!-- Layer 1: YFex core + YFex.Validation + the leaf YFex.Authorization.Public (typed Permission, authorization-consolidation
       ⚑Z2). Must NOT reference YFex.State / YFex.Cqrs / the YFex.Authorization runtime. Design: docs/internal/validation/04-06. -->
  <ItemGroup>
    <ProjectReference Include="..\..\YFex\YFex.csproj" />
    <ProjectReference Include="..\YFex.Validation\YFex.Validation.csproj" />
    <ProjectReference Include="..\..\..\..\YFex.Authorization\src\YFex.Authorization.Public\YFex.Authorization.Public.csproj" />
  </ItemGroup>

  <!-- Bundle generator: consumers get runtime + codegen from one package reference. -->
  <ItemGroup>
    <ProjectReference Include="..\YFex.Rules.Generator\YFex.Rules.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- [Union] / IUnion (BCL, .NET 11). -->
    <Using Include="System.Runtime.CompilerServices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YFex.Rules.Tests" />
  </ItemGroup>

</Project>
