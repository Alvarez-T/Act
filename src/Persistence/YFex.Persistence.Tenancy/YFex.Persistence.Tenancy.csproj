<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>YFex.Persistence.Tenancy</PackageId>
    <Description>Opt-in tenant data isolation for YFex.Persistence: scoping decorators for IKeyValueStore / ISyncLocalStore / ICache that partition keys by the ambient YFex.Tenancy scope. YFex.Persistence itself takes no tenancy dependency.</Description>
    <PackageTags>yfex;persistence;tenancy;multi-tenant;isolation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Persistence\YFex.Persistence.csproj" />
    <ProjectReference Include="..\..\..\..\YFex.Tenancy\src\YFex.Tenancy\YFex.Tenancy.csproj" />
  </ItemGroup>

</Project>
