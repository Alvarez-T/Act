<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>YFex.Persistence.Sqlite</PackageId>
    <Description>SQLite (Microsoft.Data.Sqlite) backend for YFex.Persistence: SqliteKeyValueStore and SqliteDurableQueue&lt;T&gt; over a local WAL database. Replaces the per-project SQLite storage stacks.</Description>
    <PackageTags>yfex;persistence;sqlite;storage;queue</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Persistence\YFex.Persistence.csproj" />
  </ItemGroup>

</Project>
