<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>YFex.Persistence.Encryption</PackageId>
    <Description>Encryption at rest for any YFex.Persistence IKeyValueStore backend, on YFex.Cryptography: values sealed (AES-256-GCM, sealed value v3) and bound to store name + key; storage key in the key ring "device/storage", wrapped by a non-exportable CNG key (TPM first) on Windows or a 0600 root-key file elsewhere, or a key supplied by the app. Reads the 0x01/0x02 layouts of earlier versions.</Description>
    <PackageTags>yfex;persistence;encryption;aes-gcm;security;storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.5.26302.115" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Persistence\YFex.Persistence.csproj" />
    <!-- Sibling repo C:\Dev\YFex\YFex.Cryptography (cryptography ⚑K1, ⚑K15: this package is a thin adapter over it). -->
    <ProjectReference Include="..\..\..\..\YFex.Cryptography\src\YFex.Cryptography\YFex.Cryptography.csproj" />
    <ProjectReference Include="..\..\..\..\YFex.Cryptography\src\YFex.Cryptography.Windows\YFex.Cryptography.Windows.csproj" />
  </ItemGroup>

</Project>
