<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>YFex.State</RootNamespace>
    <AssemblyName>YFex.State</AssemblyName>
  </PropertyGroup>

  <!-- Layer 1 → Layer 0.5: violations, rule contracts and the result type come from YFex.Validation (D2). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Validation\YFex.Validation\YFex.Validation.csproj" />
  </ItemGroup>

  <!-- Bundle generator: consumers get runtime + codegen from one package reference -->
  <ItemGroup>
    <ProjectReference Include="..\YFex.State.Generator\YFex.State.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
