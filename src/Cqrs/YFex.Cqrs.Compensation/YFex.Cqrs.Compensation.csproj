<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>Preview</LangVersion>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>YFex.Cqrs.Compensation</PackageId>
    <Description>Reversible-command execution primitive for YFex.Cqrs: a durable command journal plus reverse (compensation) dispatch. Declaration lives in YFex.Cqrs; this library journals executed reversible commands and materializes/dispatches their reverse command on undo.</Description>
    <PackageTags>yfex;cqrs;compensation;reversible;undo;journal</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YFex.Cqrs\YFex.Cqrs.csproj" />
    <ProjectReference Include="..\..\Persistence\YFex.Persistence\YFex.Persistence.csproj" />
  </ItemGroup>

</Project>
